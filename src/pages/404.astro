---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page not found" description="The page you requested could not be found." noindex>
  <section class="px-6 py-24">
    <div class="container-site flex max-w-[720px] flex-col items-start gap-6">
      <p class="text-[15px] font-semibold uppercase tracking-[0.16em] text-teal-dark">Error 404</p>
      <h1 class="text-navy">We couldn't find that page.</h1>
      <p class="text-[18px]">
        The page may have moved or the link may be out of date. You can browse our services or get in touch and
        we'll point you in the right direction.
      </p>
      <div class="flex flex-wrap gap-3.5 pt-2">
        <Button href="/services">Browse Our Services</Button>
        <a
          href="/contact"
          class="inline-flex min-h-[52px] items-center justify-center rounded-[--radius-btn] border-[1.5px] border-teal px-7 font-semibold text-teal-dark hover:bg-pale"
        >
          Contact Us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
