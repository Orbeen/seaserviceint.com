---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Plate from '../components/Plate.astro';
import CtaBand from '../components/CtaBand.astro';
import { GALLERY_CATEGORIES, GALLERY_ITEMS, CATEGORY_LABEL } from '../data/gallery';
---

<BaseLayout
  title="Gallery"
  description="A visual look at the marine operations SeaServe Int. supports: vessel and port operations, ship supply, crew support, repair and survey work."
  current="gallery"
>
  <PageHero
    title="Our Work at Sea and in Port"
    lede="A visual look at the kinds of marine operations SeaServe supports."
    variant="anchor"
    minHeight="380px"
    trail={[{ label: 'Gallery' }]}
  />

  <section class="px-6 pb-24 pt-[72px]">
    <div class="container-site flex flex-col gap-8">
      <div class="rounded-xl border-[1.5px] border-dashed border-teal bg-pale px-5 py-4">
        <strong class="text-navy">Illustrative imagery.</strong> These are placeholders and do not show completed
        SeaServe work. They will be replaced with SeaServe project photographs.
      </div>

      <div role="group" aria-label="Filter gallery by category" class="flex flex-wrap gap-2.5" data-filters>
        {
          GALLERY_CATEGORIES.map((c, i) => (
            <button
              type="button"
              data-filter={c.id}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="min-h-[44px] cursor-pointer rounded-full border-[1.5px] border-teal px-5 text-[15px] font-semibold aria-pressed:bg-teal aria-pressed:text-white bg-white text-teal-dark"
            >
              {c.label}
            </button>
          ))
        }
      </div>

      <!-- Announces the filtered count to screen readers -->
      <p class="sr-only text-[14px] text-muted" aria-live="polite" data-filter-status>
        Showing all {GALLERY_ITEMS.length} images
      </p>

      <div
        class="grid gap-4"
        style="grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); grid-auto-rows: 260px"
        data-gallery
      >
        {
          GALLERY_ITEMS.map((g) => (
            <figure class="relative m-0 overflow-hidden rounded-[--radius-card]" data-category={g.category}>
              <Plate variant={g.variant} />
              <figcaption
                class="absolute inset-x-0 bottom-0 px-4.5 pb-4 pt-10 text-white"
                style="background: linear-gradient(0deg, rgba(8,43,69,0.9), rgba(8,43,69,0))"
              >
                <span class="block font-semibold">{g.caption}</span>
                <span class="block text-[13px] text-aqua">{CATEGORY_LABEL.get(g.category)}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand lede="Tell us about your vessel, port call, or service requirement." secondary={false} />
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>

<script>
  // Without JS all 10 items render and remain visible — a correct, usable page.
  const filterBar = document.querySelector<HTMLElement>('[data-filters]');
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');

  if (filterBar && gallery) {
    const buttons = filterBar.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const figures = gallery.querySelectorAll<HTMLElement>('[data-category]');

    filterBar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!btn) return;

      const want = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));

      let shown = 0;
      figures.forEach((fig) => {
        const match = want === 'all' || fig.dataset.category === want;
        fig.hidden = !match;
        if (match) shown++;
      });

      if (status) {
        status.textContent =
          want === 'all' ? `Showing all ${shown} images` : `Showing ${shown} of ${figures.length} images`;
      }
    });
  }
</script>
