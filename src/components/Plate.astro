---
import type { PlateVariant } from '../data/services';
import { PLATE_IMAGES, PLATE_LABELS, SHOW_PLACEHOLDER_CHIP } from '../data/plates';

interface Props {
  variant: PlateVariant;
  /** 0–1 navy scrim, for hero text legibility. */
  dim?: number;
  /** Show the "Illustrative placeholder" chip. Auto-hidden once a photo exists. */
  chip?: boolean;
  /** Decorative use — hides from assistive tech instead of labelling. */
  decorative?: boolean;
  class?: string;
}

const { variant, dim = 0, chip = true, decorative = false, class: cls = '' } = Astro.props;

const photo = PLATE_IMAGES[variant];
const label = PLATE_LABELS[variant];

// Which scene layers this variant draws. A vessel appears in most scenes;
// the quay-side variants replace it with their own subject.
const hasShip = !['repair', 'spares', 'docs', 'supply'].includes(variant);
const a11y = decorative
  ? { 'aria-hidden': 'true' as const }
  : { role: 'img' as const, 'aria-label': label };
---

<div class={`absolute inset-0 overflow-hidden bg-navy ${cls}`}>
  {
    photo ? (
      <img
        src={photo}
        alt={decorative ? '' : label}
        class="absolute inset-0 h-full w-full object-cover"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <svg
        viewBox="0 0 800 500"
        preserveAspectRatio="xMidYMid slice"
        class="absolute inset-0 block h-full w-full"
        {...a11y}
      >
        <defs>
          <linearGradient id={`sky-${variant}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#BFE0E6" />
            <stop offset="1" stop-color="#EAF5F7" />
          </linearGradient>
          <linearGradient id={`sea-${variant}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#087E8B" />
            <stop offset="1" stop-color="#082B45" />
          </linearGradient>
        </defs>

        <rect width="800" height="320" fill={`url(#sky-${variant})`} />
        <rect y="320" width="800" height="180" fill={`url(#sea-${variant})`} />
        <path
          d="M0 340 Q 100 328 200 340 T 400 340 T 600 340 T 800 340"
          fill="none"
          stroke="#36C6BB"
          stroke-width="2"
          opacity="0.5"
        />
        <path
          d="M0 400 Q 100 388 200 400 T 400 400 T 600 400 T 800 400"
          fill="none"
          stroke="#36C6BB"
          stroke-width="2"
          opacity="0.35"
        />
        <path
          d="M0 450 Q 100 440 200 450 T 400 450 T 600 450 T 800 450"
          fill="none"
          stroke="#EAF5F7"
          stroke-width="1.5"
          opacity="0.25"
        />

        {
          variant === 'port' && (
            <g>
              <rect x="0" y="328" width="190" height="172" fill="#273844" />
              <path
                d="M30 328V190M110 328V190M30 190h140M30 230h80M110 190l60 40M170 190v-30M30 190l-20-12M170 160h-60"
                fill="none"
                stroke="#082B45"
                stroke-width="6"
                stroke-linejoin="round"
              />
              <path d="M-10 160H200" stroke="#082B45" stroke-width="8" />
            </g>
          )
        }

        {
          hasShip && (
            <g>
              <path d="M150 335H690L650 392H190Z" fill="#082B45" />
              <path d="M162 346H678" stroke="#087E8B" stroke-width="5" />
              <rect x="215" y="292" width="52" height="43" fill="#087E8B" />
              <rect x="267" y="292" width="52" height="43" fill="#36C6BB" />
              <rect x="319" y="292" width="52" height="43" fill="#EAF5F7" />
              <rect x="371" y="292" width="52" height="43" fill="#273844" />
              <rect x="423" y="292" width="52" height="43" fill="#087E8B" />
              <rect x="241" y="250" width="52" height="42" fill="#EAF5F7" />
              <rect x="293" y="250" width="52" height="42" fill="#087E8B" />
              <rect x="345" y="250" width="52" height="42" fill="#36C6BB" />
              <rect x="397" y="250" width="52" height="42" fill="#273844" />
              <rect x="540" y="258" width="76" height="77" fill="#EAF5F7" />
              <rect x="540" y="258" width="76" height="12" fill="#273844" />
              <rect x="548" y="278" width="60" height="9" fill="#082B45" />
              <rect x="556" y="232" width="22" height="26" fill="#087E8B" />
              <path
                d="M150 392Q 120 400 80 398M650 392Q 700 402 760 398"
                fill="none"
                stroke="#EAF5F7"
                stroke-width="3"
                opacity="0.6"
              />
            </g>
          )
        }

        {
          variant === 'supply' && (
            <g>
              <rect x="0" y="420" width="800" height="80" fill="#273844" />
              <rect x="40" y="350" width="90" height="70" fill="#EAF5F7" stroke="#082B45" stroke-width="3" />
              <path d="M40 350l90 70M130 350l-90 70" stroke="#087E8B" stroke-width="3" />
              <rect x="130" y="370" width="70" height="50" fill="#36C6BB" stroke="#082B45" stroke-width="3" />
              <rect x="70" y="290" width="70" height="60" fill="#087E8B" stroke="#082B45" stroke-width="3" />
              <rect x="640" y="360" width="110" height="60" fill="#EAF5F7" stroke="#082B45" stroke-width="3" />
              <path d="M640 390h110" stroke="#087E8B" stroke-width="3" />
            </g>
          )
        }

        {
          variant === 'repair' && (
            <g>
              <rect y="330" width="800" height="170" fill="#273844" />
              <path d="M0 380H800M0 430H800M200 330V500M400 330V500M600 330V500" stroke="#082B45" stroke-width="4" />
              <circle cx="400" cy="380" r="9" fill="#36C6BB" />
              <circle cx="378" cy="362" r="4" fill="#EAF5F7" />
              <circle cx="426" cy="358" r="3" fill="#EAF5F7" />
              <circle cx="415" cy="344" r="3" fill="#36C6BB" />
              <path d="M400 380L330 440" stroke="#EAF5F7" stroke-width="5" stroke-linecap="round" />
            </g>
          )
        }

        {
          variant === 'crew' && (
            <g>
              <rect x="0" y="400" width="140" height="100" fill="#273844" />
              <path d="M140 402L280 336" stroke="#EAF5F7" stroke-width="5" />
              <path d="M170 388V362M210 369V343M250 350V324" stroke="#EAF5F7" stroke-width="3" />
              <circle cx="190" cy="356" r="7" fill="#082B45" />
              <rect x="184" y="363" width="12" height="26" rx="4" fill="#087E8B" />
              <circle cx="232" cy="336" r="7" fill="#082B45" />
              <rect x="226" y="343" width="12" height="26" rx="4" fill="#36C6BB" />
              <circle cx="60" cy="378" r="7" fill="#082B45" />
              <rect x="54" y="385" width="12" height="26" rx="4" fill="#EAF5F7" />
            </g>
          )
        }

        {
          variant === 'survey' && (
            <g>
              <path
                d="M165 352H650M200 346v12M260 346v12M320 346v12M380 346v12M440 346v12M500 346v12M560 346v12M620 346v12"
                stroke="#EAF5F7"
                stroke-width="2.5"
              />
              <circle cx="560" cy="400" r="62" fill="#EAF5F7" fill-opacity="0.15" stroke="#EAF5F7" stroke-width="7" />
              <path d="M604 444L668 508" stroke="#EAF5F7" stroke-width="12" stroke-linecap="round" />
            </g>
          )
        }

        {
          variant === 'clean' && (
            <g fill="none" stroke="#EAF5F7" stroke-width="2.5" opacity="0.85">
              <circle cx="240" cy="372" r="9" />
              <circle cx="276" cy="360" r="6" />
              <circle cx="330" cy="376" r="11" />
              <circle cx="390" cy="362" r="7" />
              <circle cx="460" cy="374" r="10" />
              <circle cx="520" cy="360" r="6" />
              <path d="M200 420Q 260 400 320 420T 440 420T 560 420" stroke="#36C6BB" stroke-width="4" />
            </g>
          )
        }

        {
          variant === 'spares' && (
            <g>
              <rect x="0" y="420" width="800" height="80" fill="#273844" />
              <circle cx="140" cy="380" r="48" fill="#EAF5F7" stroke="#082B45" stroke-width="5" />
              <circle cx="140" cy="380" r="16" fill="#082B45" />
              <path
                d="M140 322v-14M140 438v14M82 380H68M198 380h14M99 339l-10-10M181 421l10 10M99 421l-10 10M181 339l10-10"
                stroke="#EAF5F7"
                stroke-width="9"
                stroke-linecap="round"
              />
              <rect x="620" y="352" width="120" height="68" fill="#36C6BB" stroke="#082B45" stroke-width="4" />
              <rect x="650" y="332" width="60" height="20" fill="#087E8B" stroke="#082B45" stroke-width="4" />
            </g>
          )
        }

        {
          variant === 'docs' && (
            <g>
              <rect x="0" y="420" width="800" height="80" fill="#273844" />
              <rect x="60" y="356" width="120" height="64" fill="#087E8B" stroke="#082B45" stroke-width="3" />
              <rect x="180" y="356" width="120" height="64" fill="#36C6BB" stroke="#082B45" stroke-width="3" />
              <rect x="120" y="292" width="120" height="64" fill="#EAF5F7" stroke="#082B45" stroke-width="3" />
              <rect x="500" y="356" width="120" height="64" fill="#EAF5F7" stroke="#082B45" stroke-width="3" />
              <rect x="620" y="356" width="120" height="64" fill="#087E8B" stroke="#082B45" stroke-width="3" />
              <path
                d="M80 356v64M100 356v64M120 356v64M200 356v64M220 356v64M240 356v64M520 356v64M540 356v64M560 356v64M640 356v64M660 356v64M680 356v64"
                stroke="#082B45"
                stroke-width="2"
                opacity="0.5"
              />
            </g>
          )
        }

        {dim > 0 && <rect width="800" height="500" fill="#082B45" opacity={String(dim)} />}
      </svg>
    )
  }

  {
    SHOW_PLACEHOLDER_CHIP && chip && !photo && (
      <div class="absolute right-2.5 top-2.5 rounded-full bg-navy/85 px-2.5 py-0.5 text-[11px] font-semibold tracking-wide text-white">
        Illustrative placeholder
      </div>
    )
  }
</div>
